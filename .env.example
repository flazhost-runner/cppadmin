# CppAdmin — copy to .env and fill in values
# NEVER commit .env to version control

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=CppAdmin
APP_ENV=development           # development | production | test
APP_MODE=full                 # full (web+api) | api (api-only)
APP_URL=http://localhost:3000
APP_PORT=3000

# ── Secrets (REQUIRED in production) ─────────────────────────────────────────
SESSION_SECRET=change-me-session-secret-min-32-chars
SESSION_TTL_HOURS=6
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=1h

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=10
DEFAULT_PAGE_SIZE=10

# ── Database (overrides config.json db_clients[0]) ───────────────────────────
# For SQLite (dev/test):
DB_TYPE=sqlite3
DB_FILE=./dev.db
# For MySQL:
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cppadmin
# DB_USERNAME=root
# DB_PASSWORD=secret
# For PostgreSQL:
# DB_TYPE=postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=cppadmin
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── File storage ──────────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | oss | s3
STORAGE_DRIVER=local
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_SSL=true

# ── Email / Mail ──────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=CppAdmin
MAIL_FROM_ADDRESS=
