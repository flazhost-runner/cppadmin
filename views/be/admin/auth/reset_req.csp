<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
%>
<%layout views::be::admin::layouts::full_width %>
<%c++
const auto& _d = reset_req_view_data;
auto& _s = reset_req_tmp_stream;
std::string logoUrl       = v(_d, "settingLogo");
std::string loginImageUrl = v(_d, "settingLoginImage");
%>
<div class="w-full max-w-5xl tw-card overflow-hidden grid md:grid-cols-2">
  <div class="hidden md:flex sidebar-gradient items-center justify-center p-10">
    <img class="max-w-full max-h-80 object-contain" src="<%c++ hout(_s, loginImageUrl); %>" alt="">
  </div>

  <div class="p-8 md:p-12 flex flex-col justify-center">
    <div class="mb-8 text-center">
      <img class="h-14 mx-auto object-contain" src="<%c++ hout(_s, logoUrl); %>" alt="logo">
    </div>

<%c++ flashAlerts(_s, _d); %>

    <div class="mb-6">
      <h1 class="text-2xl font-bold" style="color:var(--primary)">Forgot Password</h1>
      <p class="text-sm text-gray-500">Enter your Email to continue</p>
    </div>

    <form method="POST" action="/admin/v1/auth/reset/request">
<%c++ csrfInput(_s, _d); %>
      <div class="mb-3">
        <label for="email" class="form-label fw-semibold">Email</label>
        <input id="email" type="email" class="form-control" name="email" autocomplete="email">
      </div>
      <button type="submit" class="btn btn-primary-tw w-100 py-2 mb-3">Send OTP</button>
    </form>

    <hr class="my-4">
    <div class="text-center small">
      <a class="text-primary-tw text-decoration-none" href="/auth/login">back?</a>
    </div>
  </div>
</div>
