<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
%>
<%layout views::be::admin::layouts::main %>
<%c++

const auto& _d = show_view_data;
auto& _s = show_tmp_stream;
%>
<div class="card">
  <div class="card-header">
    <h2 class="card-title">Profile</h2>
    <div style="display:flex;gap:.5rem;">
      <a href="/admin/v1/profile/edit" class="btn btn-primary btn-sm">Edit Profile</a>
      <a href="/admin/v1/profile/password" class="btn btn-outline btn-sm">Change Password</a>
    </div>
  </div>
  <table style="max-width:600px;">
    <tr><th style="width:160px;">Name</th><td><%c++ hout(_s, v(_d,"currentUserName")); %></td></tr>
    <tr><th>Email</th><td><%c++ hout(_s, v(_d,"currentUserEmail")); %></td></tr>
  </table>
</div>
