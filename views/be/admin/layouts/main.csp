<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
%>
<%c++
const auto& _d = main_view_data;
auto& _s = main_tmp_stream;
%>
<%view views::be::admin::layouts::head %>
<body id="page-top" class="min-h-screen">
<%view views::be::admin::layouts::sidebar %>

<!-- Content wrapper (offset untuk sidebar di desktop) -->
<div class="md:ml-64 min-h-screen flex flex-col">
    <div class="px-4 md:px-6 pt-4">
<%view views::be::admin::layouts::topbar %>
    </div>

    <main class="flex-1 px-4 md:px-6 pb-10">
<%c++ _s << _d.get<std::string>(""); %>
    </main>
</div>

<%view views::be::admin::layouts::foot %>
