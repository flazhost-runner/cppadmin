<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
#include "helpers/Pagination.h"
#include "FeTemplates.h"
#include <drogon/utils/Utilities.h>
%>
<%layout views::be::admin::layouts::main %>
<%c++
const auto& _d = edit_view_data;
auto& _s = edit_tmp_stream;

std::string sName        = v(_d, "sName");
std::string sDescription = v(_d, "sDescription");
std::string sEmail       = v(_d, "sEmail");
std::string sPhone       = v(_d, "sPhone");
std::string sAddress     = v(_d, "sAddress");
std::string sCopyright   = v(_d, "sCopyright");
std::string sTheme       = v(_d, "sTheme");
std::string sInitial     = v(_d, "sInitial");
std::string sIcon        = v(_d, "sIcon");
std::string sLogo        = v(_d, "sLogo");
std::string sFavicon     = v(_d, "sFavicon");
std::string sLoginImage  = v(_d, "sLoginImage");

// 5 standard themes matching NodeAdmin exactly
struct ThemeDef { std::string name, primary, secondary, light, dark; };
const std::vector<ThemeDef> themes = {
    {"Blue",   "#3B82F6","#60A5FA","#EFF6FF","#1E40AF"},
    {"Purple", "#8B5CF6","#A78BFA","#F5F3FF","#5B21B6"},
    {"Green",  "#10B981","#34D399","#ECFDF5","#065F46"},
    {"Orange", "#F59E0B","#FCD34D","#FFFBEB","#92400E"},
    {"Red",    "#EF4444","#F87171","#FEF2F2","#991B1B"},
};
std::string themesHtml;
for (const auto& t : themes) {
    bool active = (sTheme == t.name);
    themesHtml += "<label class=\"cursor-pointer block\">";
    themesHtml += "<input type=\"radio\" name=\"theme\" value=\"" + h(t.name) + "\" class=\"sr-only theme-radio\"" + (active ? " checked" : "") + ">";
    themesHtml += "<div class=\"theme-swatch rounded-xl overflow-hidden border-2 transition " + std::string(active ? "border-gray-800" : "border-transparent") + "\" style=\"box-shadow:0 4px 10px rgba(0,0,0,.08)\">";
    themesHtml += "<div class=\"h-16 flex\">";
    themesHtml += "<div class=\"flex-1\" style=\"background:" + t.dark + "\"></div>";
    themesHtml += "<div class=\"flex-1\" style=\"background:" + t.primary + "\"></div>";
    themesHtml += "<div class=\"flex-1\" style=\"background:" + t.secondary + "\"></div>";
    themesHtml += "<div class=\"flex-1\" style=\"background:" + t.light + "\"></div>";
    themesHtml += "</div>";
    themesHtml += "<div class=\"bg-white py-2 px-3 flex items-center justify-between\">";
    themesHtml += "<span class=\"text-sm font-semibold text-gray-700\">" + h(t.name) + "</span>";
    themesHtml += "<i class=\"fas fa-check-circle check-icon" + std::string(active ? "" : " hidden") + "\" style=\"color:" + t.primary + "\"></i>";
    themesHtml += "</div></div></label>\n";
}

// ── Frontend Template switcher — katalog dari controller (640 opentailwind
//    atau fallback kurasi 15 saat offline), paginasi + pencarian server-side.
auto feItems      = _d.get<std::vector<fetpl::Item>>("feCatalogItems");
auto feCategories = _d.get<std::vector<std::string>>("feCategories");
int feTotal      = _d.get<int>("feCatalogTotal");
int fePage       = _d.get<int>("feCatalogPage");
int fePageSize   = _d.get<int>("feCatalogPageSize");
int feTotalPages = _d.get<int>("feCatalogTotalPages");
std::string feQName     = v(_d, "feQName");
std::string feQCategory = v(_d, "feQCategory");
std::string feActiveSlug = v(_d, "sFeTemplate");
if (feActiveSlug.empty()) feActiveSlug = fetpl::kDefault;
if (fePageSize <= 0) fePageSize = 12;
if (fePage <= 0) fePage = 1;

// Kartu katalog: thumbnail = iframe preview lazy (IntersectionObserver +
// cache localStorage), klik thumbnail → modal preview penuh, tombol PILIH.
std::string feCatalogHtml;
for (const auto& t : feItems) {
    bool active = (feActiveSlug == t.slug);
    std::string activeClass = active ? "border-gray-900" : "border-gray-300";
    std::string checkClass  = active ? "" : " hidden";
    std::string btnClass    = active ? "btn-primary-tw" : "btn-outline-dark";
    std::string btnText     = active
        ? "<i class=\"fas fa-check me-1\"></i> TERPILIH"
        : "<i class=\"fas fa-hand-pointer me-1\"></i> PILIH";
    feCatalogHtml +=
        "<div class=\"fe-card block\" data-slug=\"" + h(t.slug) + "\">"
        "<div class=\"fe-swatch rounded-xl overflow-hidden border-2 transition " + activeClass + "\" style=\"box-shadow:0 2px 8px rgba(0,0,0,.12)\">"
        "<div class=\"fe-thumb fe-preview-trigger relative bg-gray-100 cursor-pointer group\" data-slug=\"" + h(t.slug) + "\""
        " data-name=\"" + h(t.name) + "\""
        " style=\"height:140px;overflow:hidden;border-bottom:1px solid #d1d5db;border-top-left-radius:.7rem;border-top-right-radius:.7rem;transform:translateZ(0)\""
        " data-preview-url=\"/admin/v1/setting/fe-preview/" + h(t.slug) + "\">"
        "<div class=\"fe-thumb-placeholder absolute inset-0 flex items-center justify-center text-gray-300\">"
        "<i class=\"fas fa-spinner fa-spin\"></i></div>"
        "<div class=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition\""
        " style=\"background:rgba(0,0,0,.45);pointer-events:none\">"
        "<span class=\"text-white text-sm font-semibold\"><i class=\"fas fa-eye me-1\"></i> Preview</span></div>"
        "</div>"
        "<div class=\"bg-white py-2 px-3\">"
        "<div class=\"flex items-center justify-between\">"
        "<span class=\"text-sm font-semibold text-gray-800 truncate\" title=\"" + h(t.name) + "\">" + h(t.name) + "</span>"
        "<i class=\"fas fa-check-circle fe-check" + checkClass + "\" style=\"color:var(--primary)\"></i></div>"
        "<span class=\"text-xs text-gray-400\">" + h(t.category) + "</span>"
        "<button type=\"button\" class=\"fe-select btn btn-sm w-100 mt-2 fw-bold " + btnClass + "\" style=\"font-size:13px;letter-spacing:.3px\">" + btnText + "</button>"
        "</div></div></div>\n";
}

// URL katalog dgn q_page diganti (pagination server-side, filter dipertahankan).
auto fePageUrl = [&](int p) {
    return "/admin/v1/setting?q_page=" + std::to_string(p)
        + "&q_page_size=" + std::to_string(fePageSize)
        + "&q_name=" + drogon::utils::urlEncodeComponent(feQName)
        + "&q_category=" + drogon::utils::urlEncodeComponent(feQCategory);
};
%>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Setting Management</h1>
</div>

<!-- Form pencarian katalog FE (GET) — SENGAJA di luar form POST setting
     (form HTML tak boleh nested); input di kartu Frontend Template
     berasosiasi via atribut form="fe_search". -->
<form id="fe_search" method="GET" action="/admin/v1/setting"></form>

<form method="POST" action="/admin/v1/setting?_method=PUT" enctype="multipart/form-data">
<%c++ csrfInput(_s, _d); %>
<%c++ flashAlerts(_s, _d); %>

  <!-- Admin Theme Switcher -->
  <div class="tw-card p-6 mb-6">
    <div class="flex items-center gap-2 mb-1">
      <i class="fas fa-palette" style="color:var(--primary)"></i>
      <h2 class="text-lg font-bold" style="color:var(--primary)">Admin Theme</h2>
    </div>
    <p class="text-sm text-gray-500 mb-4">Choose a theme — admin appearance will update after saving.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
<%c++ _s << themesHtml; %>
    </div>
  </div>

  <!-- Frontend Template Switcher (katalog 640, paginated + search) -->
  <div class="tw-card p-6 mb-6">
    <div class="flex items-center gap-2 mb-1">
      <i class="fas fa-window-maximize" style="color:var(--primary)"></i>
      <h2 class="text-lg font-bold" style="color:var(--primary)">Frontend Template</h2>
    </div>
    <p class="text-sm text-gray-500 mb-4">
      Pilih desain halaman depan (landing) publik dari
      <a href="https://github.com/lindoai/opentailwind" target="_blank" class="underline">opentailwind</a>
      (<%c++ _s << feTotal; %> template). Klik <b>Preview</b> untuk lihat penuh.
      Template terpilih diunduh &amp; di-cache saat <b>Save</b>. Lihat hasilnya di
      <a href="/" target="_blank" class="underline" style="color:var(--primary)">halaman depan ↗</a>.
    </p>

    <!-- Slug terpilih (di-submit bersama form POST setting). Dipertahankan via
         localStorage agar tak hilang saat pindah halaman katalog. -->
    <input type="hidden" id="fe_template_input" name="fe_template" value="<%c++ hout(_s, feActiveSlug); %>">

    <!-- Search + filter kategori (GET, server-side) -->
    <div class="flex flex-wrap items-end gap-2 mb-4">
      <div>
        <label class="block text-xs text-gray-500 mb-1">Cari nama</label>
        <input form="fe_search" type="text" name="q_name" value="<%c++ hout(_s, feQName); %>"
               placeholder="mis. agency, saas…" class="form-control" style="min-width:220px">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Kategori</label>
        <select form="fe_search" name="q_category" class="form-control" style="min-width:200px">
          <option value="">Semua kategori</option>
<%c++
for (const auto& c : feCategories) {
    _s << "<option value=\"" << h(c) << "\"" << (feQCategory == c ? " selected" : "") << ">" << h(c) << "</option>\n";
}
%>
        </select>
      </div>
      <input form="fe_search" type="hidden" name="q_page_size" value="<%c++ _s << fePageSize; %>">
      <button form="fe_search" type="submit" class="btn btn-success btn-sm" style="height:38px">
        <i class="fas fa-search me-1"></i> Cari
      </button>
      <a href="/admin/v1/setting" class="btn btn-danger btn-sm" style="height:38px">
        <i class="fas fa-times me-1"></i> Reset
      </a>
    </div>

<%c++ if (feItems.empty()) { %>
    <div class="text-center text-gray-400 py-10">
      <i class="fas fa-search fa-2x mb-2"></i>
      <p>Tidak ada template yang cocok dengan pencarian.</p>
    </div>
<%c++ } %>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
<%c++ _s << feCatalogHtml; %>
    </div>

<%c++
// Pagination katalog — berjendela (1 … cur-2..cur+2 … last) via PaginateMeta.
if (feTotalPages > 1) {
    PaginateMeta meta;
    meta.total = feTotal; meta.page = fePage; meta.pageSize = fePageSize;
    meta.totalPages = feTotalPages;
    meta.hasPrev = fePage > 1; meta.hasNext = fePage < feTotalPages;
    _s << "<div class=\"d-flex justify-content-center mt-5\"><nav><ul class=\"pagination\">\n";
    if (meta.hasPrev)
        _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"" << fePageUrl(fePage - 1) << "\">Previous</a></li>\n";
    for (int n : meta.pageNumbers()) {
        if (n == -1) {
            _s << "<li class=\"page-item disabled\"><span class=\"page-link\">…</span></li>\n";
        } else {
            _s << "<li class=\"page-item" << (n == fePage ? " active" : "") << "\">"
               << "<a class=\"page-link\" href=\"" << fePageUrl(n) << "\">" << n << "</a></li>\n";
        }
    }
    if (meta.hasNext)
        _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"" << fePageUrl(fePage + 1) << "\">Next</a></li>\n";
    _s << "</ul></nav></div>\n";
}
%>
  </div>

  <!-- Setting Form -->
  <div class="tw-card p-6">
    <h2 class="text-lg font-bold mb-4" style="color:var(--primary)">Setting Form</h2>

    <div class="mb-3">
      <label for="initial" class="form-label fw-semibold">Initial</label>
      <input id="initial" type="text" class="form-control" name="initial" value="<%c++ hout(_s,sInitial); %>">
    </div>

    <div class="mb-3">
      <label for="name" class="form-label fw-semibold">App Name</label>
      <input id="name" type="text" class="form-control" name="name" value="<%c++ hout(_s,sName); %>">
    </div>

    <div class="mb-3">
      <label for="description" class="form-label fw-semibold">Description</label>
      <textarea id="description" class="trumbowyg-editor form-control" name="description"><%c++ hout(_s,sDescription); %></textarea>
    </div>

    <div class="mb-3">
      <label for="email" class="form-label fw-semibold">Email</label>
      <input id="email" type="email" class="form-control" name="email" value="<%c++ hout(_s,sEmail); %>">
    </div>

    <div class="mb-3">
      <label for="phone" class="form-label fw-semibold">Phone</label>
      <input id="phone" type="text" class="form-control" name="phone" value="<%c++ hout(_s,sPhone); %>">
    </div>

    <div class="mb-3">
      <label for="address" class="form-label fw-semibold">Address</label>
      <input id="address" type="text" class="form-control" name="address" value="<%c++ hout(_s,sAddress); %>">
    </div>

    <div class="mb-3">
      <label for="copyright" class="form-label fw-semibold">Copyright</label>
      <input id="copyright" type="text" class="form-control" name="copyright" value="<%c++ hout(_s,sCopyright); %>">
    </div>

    <div class="mb-4">
      <label for="logo" class="form-label fw-semibold">Company Logo</label>
      <% if (!sLogo.empty()) { %>
      <div class="mb-2"><img src="<%c++ hout(_s,sLogo); %>" alt="logo" style="max-height:60px;object-fit:contain"></div>
      <% } %>
      <input id="logo" type="file" class="form-control" name="logo" accept="image/*">
    </div>

    <div class="mb-4">
      <label for="favicon" class="form-label fw-semibold">Favicon</label>
      <% if (!sFavicon.empty()) { %>
      <div class="mb-2"><img src="<%c++ hout(_s,sFavicon); %>" alt="favicon" style="max-height:32px;object-fit:contain"></div>
      <% } %>
      <input id="favicon" type="file" class="form-control" name="favicon" accept="image/*">
    </div>

    <div class="mb-4">
      <label for="login_image" class="form-label fw-semibold">Login Image</label>
      <% if (!sLoginImage.empty()) { %>
      <div class="mb-2"><img src="<%c++ hout(_s,sLoginImage); %>" alt="login image" style="max-height:80px;object-fit:contain"></div>
      <% } %>
      <input id="login_image" type="file" class="form-control" name="login_image" accept="image/*">
    </div>

    <button type="submit" class="btn btn-primary-tw px-4 py-2">
      <i class="fas fa-save me-1"></i> Save Setting
    </button>
  </div>
</form>

<!-- Modal preview penuh template FE -->
<div id="fe-preview-modal" class="hidden fixed inset-0 z-50 items-center justify-center" style="background:rgba(0,0,0,.6)">
  <div class="bg-white rounded-xl overflow-hidden shadow-2xl" style="width:92vw;height:90vh;display:flex;flex-direction:column">
    <div class="flex items-center justify-between px-4 py-3 border-b">
      <h3 id="fe-preview-title" class="font-bold text-gray-800">Preview</h3>
      <button id="fe-preview-close" type="button" class="btn btn-sm btn-danger"><i class="fas fa-times"></i> Tutup</button>
    </div>
    <iframe id="fe-preview-frame" class="flex-1 w-full" style="border:0"></iframe>
  </div>
</div>

<script>
  // Theme live preview
  var themeColors = {
    "Blue":   {primary:"#3B82F6",secondary:"#60A5FA",light:"#EFF6FF",dark:"#1E40AF"},
    "Purple": {primary:"#8B5CF6",secondary:"#A78BFA",light:"#F5F3FF",dark:"#5B21B6"},
    "Green":  {primary:"#10B981",secondary:"#34D399",light:"#ECFDF5",dark:"#065F46"},
    "Orange": {primary:"#F59E0B",secondary:"#FCD34D",light:"#FFFBEB",dark:"#92400E"},
    "Red":    {primary:"#EF4444",secondary:"#F87171",light:"#FEF2F2",dark:"#991B1B"}
  };

  document.querySelectorAll('.theme-radio').forEach(function(r) {
    r.addEventListener('change', function() {
      var t = themeColors[r.value];
      if (!t) return;
      var root = document.documentElement;
      root.style.setProperty('--primary',      t.primary);
      root.style.setProperty('--secondary',    t.secondary);
      root.style.setProperty('--theme-light',  t.light);
      root.style.setProperty('--theme-dark',   t.dark);

      document.querySelectorAll('.theme-swatch').forEach(function(s) {
        s.classList.remove('border-gray-800'); s.classList.add('border-transparent');
      });
      document.querySelectorAll('.check-icon').forEach(function(c) { c.classList.add('hidden'); });
      var box = r.closest('label').querySelector('.theme-swatch');
      box.classList.add('border-gray-800'); box.classList.remove('border-transparent');
      r.closest('label').querySelector('.check-icon').classList.remove('hidden');
    });
  });

  // ===== Frontend Template katalog: thumbnail + preview + pilih =====
  document.addEventListener('DOMContentLoaded', function () {
    var LS_PREFIX = 'fe_tpl_html:';   // per-slug HTML cache
    var LS_SEL = 'fe_tpl_selected';   // slug terpilih (persist lintas halaman)
    var input = document.getElementById('fe_template_input');

    // Pulihkan pilihan dari localStorage bila ada (mis. setelah ganti halaman katalog)
    var savedSel = localStorage.getItem(LS_SEL);
    if (savedSel && input) input.value = savedSel;

    // Template opentailwind pakai `dark:` variant (Tailwind v4) yang default-nya
    // mengikuti prefers-color-scheme. Saat browser admin dark-mode, preview ikut
    // gelap. Paksa light: (1) redefine variant `dark` jadi class-based via
    // <style type="text/tailwindcss"> — iframe tak punya .dark jadi selalu light;
    // (2) override color-scheme agar form/scrollbar bawaan tak ikut gelap.
    function forceLight(html) {
      var inject =
        '<meta name="color-scheme" content="light">' +
        '<style type="text/tailwindcss">@custom-variant dark (&:where(.dark, .dark *));</style>' +
        '<style>:root{color-scheme:light !important}' +
        '@media (prefers-color-scheme: dark){:root{color-scheme:light !important}}</style>';
      if (/<head[^>]*>/i.test(html)) {
        return html.replace(/<head[^>]*>/i, function (m) { return m + inject; });
      }
      return inject + html;
    }

    // Ambil HTML 1 template: dari localStorage atau fetch ke server lalu cache.
    function getHtml(slug, url) {
      var cached = null;
      try { cached = localStorage.getItem(LS_PREFIX + slug); } catch (e) {}
      if (cached) return Promise.resolve(cached);
      return fetch(url, { credentials: 'same-origin' })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
        .then(function (html) {
          try { localStorage.setItem(LS_PREFIX + slug, html); } catch (e) { /* kuota penuh: skip */ }
          return html;
        });
    }

    // Render thumbnail iframe (di-scale agar ringan & terlihat seperti screenshot).
    function renderThumb(box) {
      var slug = box.getAttribute('data-slug');
      var url = box.getAttribute('data-preview-url');
      getHtml(slug, url).then(function (html) {
        var ph = box.querySelector('.fe-thumb-placeholder');
        if (ph) ph.remove();
        var ifr = document.createElement('iframe');
        ifr.setAttribute('scrolling', 'no');
        ifr.setAttribute('loading', 'lazy');
        // Scale dinamis = lebar kartu / 1280 → thumbnail isi penuh lebar (center
        // edge-to-edge), tinggi 1280 di-clip ke 140px container (overflow hidden).
        var DESIGN_W = 1280;
        var scale = (box.clientWidth || 280) / DESIGN_W;
        ifr.style.cssText = 'width:' + DESIGN_W + 'px;height:' + Math.ceil(140 / scale) +
          'px;border:0;transform:scale(' + scale + ');transform-origin:top left;pointer-events:none';
        ifr.srcdoc = forceLight(html);
        box.appendChild(ifr);
      }).catch(function () {
        var ph = box.querySelector('.fe-thumb-placeholder');
        if (ph) ph.innerHTML = '<i class="fas fa-image text-2xl"></i>';
      });
    }

    // Lazy-load thumbnail saat kartu terlihat (hemat bandwidth & CPU).
    var thumbs = document.querySelectorAll('.fe-thumb');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) { renderThumb(en.target); io.unobserve(en.target); }
        });
      }, { rootMargin: '200px' });
      thumbs.forEach(function (t) { io.observe(t); });
    } else {
      thumbs.forEach(renderThumb);
    }

    // Pilih template → set hidden input + simpan ke localStorage + update UI.
    function selectSlug(slug) {
      if (input) input.value = slug;
      try { localStorage.setItem(LS_SEL, slug); } catch (e) {}
      document.querySelectorAll('.fe-card').forEach(function (card) {
        var active = card.getAttribute('data-slug') === slug;
        var swatch = card.querySelector('.fe-swatch');
        var check = card.querySelector('.fe-check');
        var btn = card.querySelector('.fe-select');
        swatch.classList.toggle('border-gray-900', active);
        swatch.classList.toggle('border-gray-300', !active);
        if (check) check.classList.toggle('hidden', !active);
        if (btn) {
          btn.innerHTML = active
            ? '<i class="fas fa-check me-1"></i> TERPILIH'
            : '<i class="fas fa-hand-pointer me-1"></i> PILIH';
          btn.classList.toggle('btn-primary-tw', active);
          btn.classList.toggle('btn-outline-dark', !active);
        }
      });
    }

    document.querySelectorAll('.fe-select').forEach(function (b) {
      b.addEventListener('click', function () {
        selectSlug(this.closest('.fe-card').getAttribute('data-slug'));
      });
    });
    // Sinkronkan tampilan awal dengan pilihan tersimpan.
    if (input && input.value) selectSlug(input.value);

    // ===== Modal Preview penuh =====
    var modal = document.getElementById('fe-preview-modal');
    var frame = document.getElementById('fe-preview-frame');
    var title = document.getElementById('fe-preview-title');
    function openModal(slug, name, url) {
      title.textContent = name;
      frame.srcdoc = '<div style="font-family:sans-serif;padding:40px">Memuat…</div>';
      modal.classList.remove('hidden'); modal.classList.add('flex');
      getHtml(slug, url).then(function (html) { frame.srcdoc = forceLight(html); })
        .catch(function () { frame.srcdoc = '<p style="padding:40px;font-family:sans-serif">Gagal memuat preview.</p>'; });
    }
    function closeModal() { modal.classList.add('hidden'); modal.classList.remove('flex'); frame.srcdoc = ''; }
    document.querySelectorAll('.fe-preview-trigger').forEach(function (b) {
      b.addEventListener('click', function () {
        openModal(this.getAttribute('data-slug'), this.getAttribute('data-name'), this.getAttribute('data-preview-url'));
      });
    });
    document.getElementById('fe-preview-close').addEventListener('click', closeModal);
    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
  });
</script>
