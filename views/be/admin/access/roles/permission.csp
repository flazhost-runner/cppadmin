<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
#include <vector>
#include <sstream>
%>
<%layout views::be::admin::layouts::main %>
<%c++
const auto& _d = permission_view_data;
auto& _s = permission_tmp_stream;

std::string roleId   = v(_d, "roleId");
std::string roleName = v(_d, "roleName");
std::string qName    = v(_d, "qName");
std::string qStatus  = v(_d, "qStatus");
std::string qDesc    = v(_d, "qDesc");
std::string curPageStr   = v(_d, "currentPage");
std::string totalPageStr = v(_d, "totalPage");
std::string pageSizeStr  = v(_d, "pageSize");
int curPage   = curPageStr.empty()   ? 1  : std::stoi(curPageStr);
int totalPage = totalPageStr.empty() ? 1  : std::stoi(totalPageStr);
int pageSize  = pageSizeStr.empty()  ? 10 : std::stoi(pageSizeStr);
%>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">Permission Management</h1>
</div>

<%c++ flashAlerts(_s, _d); %>

<div class="tw-card p-0 overflow-hidden">
  <div class="px-6 py-4 border-b flex items-center justify-between">
    <h2 class="text-lg font-bold" style="color:var(--primary)">Permission List</h2>
    <div class="btn-group btn-sm">
      <button type="submit" form="selection"
              formmethod="post"
              formaction="/admin/v1/access/roles/<%c++ hout(_s, roleId); %>/permission/assign_selected"
              data-confirm="Confirm Assign"
              class="btn btn-info btn-sm"><i class="fas fa-check"></i> Assign Selected</button>
      <button type="submit" form="selection"
              formmethod="post"
              formaction="/admin/v1/access/roles/<%c++ hout(_s, roleId); %>/permission/unassign_selected"
              data-confirm="Confirm Unassign"
              class="btn btn-danger btn-sm"><i class="fas fa-times"></i> Unassign Selected</button>
    </div>
  </div>

  <div class="p-4" style="overflow-x:auto">
    <table class="table table-bordered table-hover align-middle">
      <thead>
        <form id="searchform" method="GET" action="/admin/v1/access/roles/<%c++ hout(_s, roleId); %>/permission">
          <tr>
            <th width="2%"></th>
            <th width="7%">
              <select name="q_page_size" class="form-control">
                <option value="10"<%c++ if(pageSize==10) _s<<" selected"; %>>10</option>
                <option value="20"<%c++ if(pageSize==20) _s<<" selected"; %>>20</option>
                <option value="50"<%c++ if(pageSize==50) _s<<" selected"; %>>50</option>
                <option value="100"<%c++ if(pageSize==100) _s<<" selected"; %>>100</option>
              </select>
            </th>
            <th width="20%"><input type="text" class="form-control" name="q_name" value="<%c++ hout(_s,qName); %>" placeholder="Name"></th>
            <th width="10%">
              <select name="q_status" class="form-control">
                <option disabled<%c++ if(qStatus.empty()) _s<<" selected"; %>>Select</option>
                <option value="Active"<%c++ if(qStatus=="Active") _s<<" selected"; %>>Active</option>
                <option value="Inactive"<%c++ if(qStatus=="Inactive") _s<<" selected"; %>>Inactive</option>
              </select>
            </th>
            <th width="15%"><input type="text" class="form-control" name="q_desc" value="<%c++ hout(_s,qDesc); %>" placeholder="Description"></th>
            <th width="5%" class="text-center align-middle">
              <div class="btn-group">
                <button type="submit" form="searchform" class="btn btn-sm btn-success"><i class="fas fa-search"></i></button>
                <a href="/admin/v1/access/roles/<%c++ hout(_s, roleId); %>/permission" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></a>
              </div>
            </th>
          </tr>
          <tr>
            <th width="5%"><input type="checkbox" id="checkall"/></th>
            <th width="5%">No</th>
            <th width="20%">Name</th>
            <th width="10%">Status</th>
            <th width="15%">Description</th>
            <th width="5%">Action</th>
          </tr>
        </form>
      </thead>
      <tbody>
        <form id="selection">
<%c++
std::string rows = v(_d, "rows");
if (rows.empty()) {
    _s << "<tr><td colspan=\"6\" class=\"text-center\" style=\"color:#9ca3af;padding:2rem\">No data yet.</td></tr>\n";
} else {
    std::istringstream rss(rows);
    std::string line;
    while(std::getline(rss, line)) {
        if(line.empty()) continue;
        std::vector<std::string> cols;
        std::string col;
        for(char c : line) { if(c=='|') { cols.push_back(col); col.clear(); } else col+=c; }
        cols.push_back(col);
        while(cols.size() < 6) cols.push_back("");
        std::string idx        = cols[0];
        std::string pid        = cols[1];
        std::string name       = cols[2];
        std::string status     = cols[3];
        std::string desc       = cols[4];
        bool isAssigned        = (cols[5] == "1");
        _s << "<tr>\n";
        _s << "  <td><input name=\"selected[]\" value=\"" << h(pid) << "\" type=\"checkbox\"/></td>\n";
        _s << "  <td>" << h(idx) << "</td>\n";
        _s << "  <td>" << h(name) << "</td>\n";
        _s << "  <td class=\"text-left\">";
        if(isAssigned)
            _s << "<i class=\"fas fa-check-circle text-green-500 text-xl\" title=\"Assigned\"></i>";
        else
            _s << "<i class=\"fas fa-times-circle text-gray-300 text-xl\" title=\"Not assigned\"></i>";
        _s << "</td>\n";
        _s << "  <td>" << h(desc) << "</td>\n";
        _s << "  <td class=\"text-center\">\n";
        _s << "    <div class=\"btn-group\">\n";
        _s << "      <button type=\"button\" class=\"btn btn-sm btn-primary dropdown-toggle\" data-toggle-dd>Action</button>\n";
        _s << "      <div class=\"dropdown-menu dropdown-menu-end\">\n";
        _s << "        <a href=\"/admin/v1/access/roles/" << h(roleId) << "/permission/" << h(pid) << "/assign\" class=\"dropdown-item\"><i class=\"fas fa-check\"></i> Assign</a>\n";
        _s << "        <div class=\"dropdown-divider\"></div>\n";
        _s << "        <a href=\"/admin/v1/access/roles/" << h(roleId) << "/permission/" << h(pid) << "/unassign\" class=\"dropdown-item danger\"><i class=\"fas fa-times\"></i> Unassign</a>\n";
        _s << "      </div>\n";
        _s << "    </div>\n";
        _s << "  </td>\n";
        _s << "</tr>\n";
    }
}
%>
        </form>
      </tbody>
    </table>

    <div class="d-flex justify-content-end mt-4">
      <nav>
        <ul class="pagination">
<%c++
if(curPage > 1)
    _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"/admin/v1/access/roles/" << h(roleId) << "/permission?q_page=" << (curPage-1) << "&q_name=" << h(qName) << "\">Previous</a></li>\n";
for(int i=1; i<=totalPage; i++)
    _s << "<li class=\"page-item" << (i==curPage?" active":"") << "\"><a class=\"page-link\" href=\"/admin/v1/access/roles/" << h(roleId) << "/permission?q_page=" << i << "&q_name=" << h(qName) << "\">" << i << "</a></li>\n";
if(curPage < totalPage && totalPage > 0)
    _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"/admin/v1/access/roles/" << h(roleId) << "/permission?q_page=" << (curPage+1) << "&q_name=" << h(qName) << "\">Next</a></li>\n";
%>
        </ul>
      </nav>
    </div>
  </div>
</div>

<script>
  $("#checkall").click(function(){ $('input:checkbox').not(this).prop('checked', this.checked); });
</script>
