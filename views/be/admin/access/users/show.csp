<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
%>
<%layout views::be::admin::layouts::main %>
<%c++

const auto& _d = show_view_data;
auto& _s = show_tmp_stream;
%>
<div class="card">
  <div class="card-header">
    <h2 class="card-title">User Detail</h2>
    <a href="/admin/v1/access/users" class="btn btn-outline btn-sm">&larr; Back</a>
  </div>
  <table style="max-width:600px;">
    <tr><th style="width:160px;">Name</th><td><%c++ hout(_s, v(_d,"userName")); %></td></tr>
    <tr><th>Email</th><td><%c++ hout(_s, v(_d,"userEmail")); %></td></tr>
    <tr><th>Phone</th><td><%c++ hout(_s, v(_d,"userPhone")); %></td></tr>
    <tr><th>Status</th><td><%c++ hout(_s, v(_d,"userStatus")); %></td></tr>
  </table>
  <div style="margin-top:1rem;display:flex;gap:.5rem;">
    <a href="edit" class="btn btn-primary btn-sm">Edit</a>
  </div>
</div>
