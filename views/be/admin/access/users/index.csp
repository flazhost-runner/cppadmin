<%inc
#include "helpers/HtmlEscape.h"
#include "helpers/CspHelpers.h"
#include <vector>
%>
<%layout views::be::admin::layouts::main %>
<%c++
const auto& _d = index_view_data;
auto& _s = index_tmp_stream;

std::string curPageStr  = v(_d, "currentPage");
std::string totalPageStr= v(_d, "totalPage");
std::string pageSizeStr = v(_d, "pageSize");
int curPage   = curPageStr.empty()   ? 1  : std::stoi(curPageStr);
int totalPage = totalPageStr.empty() ? 1  : std::stoi(totalPageStr);
int pageSize  = pageSizeStr.empty()  ? 10 : std::stoi(pageSizeStr);

std::string qCode   = v(_d, "qCode");
std::string qName   = v(_d, "qName");
std::string qPhone  = v(_d, "qPhone");
std::string qEmail  = v(_d, "qEmail");
std::string qStatus = v(_d, "qStatus");
std::string qRole   = v(_d, "qRole");
%>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-800">User Management</h1>
</div>

<div class="tw-card p-0 overflow-hidden">
  <div class="px-6 py-4 border-b flex items-center justify-between">
    <h2 class="text-lg font-bold" style="color:var(--primary)">User List</h2>
    <div class="btn-group btn-sm">
      <a href="/admin/v1/access/users/create" class="btn btn-success btn-sm"><i class="fas fa-fw fa-plus"></i> Add Data</a>
      <button type="submit" form="selection" formmethod="post"
              formaction="/admin/v1/access/users/delete_selected"
              data-confirm="Confirm Delete" class="btn btn-danger btn-sm">
        <i class="fas fa-fw fa-times"></i> Delete Selected
      </button>
    </div>
  </div>

  <div class="p-4" style="overflow-x:auto">
    <table class="table table-bordered table-hover align-middle">
      <thead>
        <form id="searchform" method="GET" action="/admin/v1/access/users">
          <tr>
            <th width="2%"></th>
            <th width="5%">
              <select name="q_page_size" class="form-control">
                <option value="10"<%c++ if(pageSize==10) _s<<" selected"; %>>10</option>
                <option value="20"<%c++ if(pageSize==20) _s<<" selected"; %>>20</option>
                <option value="50"<%c++ if(pageSize==50) _s<<" selected"; %>>50</option>
                <option value="100"<%c++ if(pageSize==100) _s<<" selected"; %>>100</option>
              </select>
            </th>
            <th><input type="text" class="form-control" name="q_code" value="<%c++ hout(_s,qCode); %>" placeholder="Code"></th>
            <th><input type="text" class="form-control" name="q_name" value="<%c++ hout(_s,qName); %>" placeholder="Name"></th>
            <th><input type="text" class="form-control" name="q_phone" value="<%c++ hout(_s,qPhone); %>" placeholder="Phone"></th>
            <th><input type="text" class="form-control" name="q_email" value="<%c++ hout(_s,qEmail); %>" placeholder="Email"></th>
            <th>
              <select name="q_status" class="form-control">
                <option value=""<%c++ if(qStatus.empty()) _s<<" selected"; %>>All</option>
                <option value="Active"<%c++ if(qStatus=="Active") _s<<" selected"; %>>Active</option>
                <option value="Inactive"<%c++ if(qStatus=="Inactive") _s<<" selected"; %>>Inactive</option>
              </select>
            </th>
            <th></th>
            <th><input type="text" class="form-control" name="q_role" value="<%c++ hout(_s,qRole); %>" placeholder="Role"></th>
            <th class="text-center align-middle">
              <div class="btn-group">
                <button type="submit" form="searchform" class="btn btn-sm btn-success"><i class="fas fa-fw fa-search"></i></button>
                <a href="/admin/v1/access/users" class="btn btn-sm btn-danger"><i class="fas fa-fw fa-times"></i></a>
              </div>
            </th>
          </tr>
          <tr>
            <th><input type="checkbox" id="checkall"/></th>
            <th>No</th>
            <th>Code</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Status</th>
            <th>Picture</th>
            <th>Roles</th>
            <th>Action</th>
          </tr>
        </form>
      </thead>
      <tbody>
        <form id="selection">
<%c++
// rows format (newline-separated, pipe-delimited): idx|id|code|name|phone|email|status|picture|roles(comma-sep)
std::string rows = v(_d, "rows");
if (rows.empty()) {
    _s << "<tr><td colspan=\"10\" class=\"text-center\" style=\"color:#9ca3af;padding:2rem\">No data yet.</td></tr>\n";
} else {
    std::istringstream rss(rows);
    std::string line;
    while(std::getline(rss, line)) {
        if(line.empty()) continue;
        std::vector<std::string> cols;
        std::string col;
        for(char c : line) { if(c=='|') { cols.push_back(col); col.clear(); } else col+=c; }
        cols.push_back(col);
        while(cols.size() < 9) cols.push_back("");
        std::string idx     = cols[0];
        std::string uid     = cols[1];
        std::string code    = cols[2];
        std::string name    = cols[3];
        std::string phone   = cols[4];
        std::string email   = cols[5];
        std::string status  = cols[6];
        std::string picture = cols[7];
        std::string roles   = cols[8];
        _s << "<tr>\n";
        _s << "  <td><input name=\"selected[]\" value=\"" << h(uid) << "\" type=\"checkbox\"/></td>\n";
        _s << "  <td>" << h(idx) << "</td>\n";
        _s << "  <td>" << h(code) << "</td>\n";
        _s << "  <td>" << h(name) << "</td>\n";
        _s << "  <td>" << h(phone) << "</td>\n";
        _s << "  <td>" << h(email) << "</td>\n";
        _s << "  <td>";
        if(status == "Active")
            _s << "<i class=\"fas fa-check-circle text-green-500 text-xl\" title=\"Active\"></i>";
        else
            _s << "<i class=\"fas fa-times-circle text-red-500 text-xl\" title=\"Inactive\"></i>";
        _s << "</td>\n";
        _s << "  <td class=\"text-center\"><img src=\"" << h(picture) << "\" style=\"max-width:100px\" class=\"rounded\" alt=\"picture\"></td>\n";
        // Roles as badges
        _s << "  <td>";
        if(!roles.empty()) {
            std::istringstream rs(roles);
            std::string rname;
            while(std::getline(rs, rname, ',')) {
                if(!rname.empty())
                    _s << "<span class=\"badge text-bg-primary me-1\">" << h(rname) << "</span>";
            }
        }
        _s << "</td>\n";
        _s << "  <td class=\"text-center\">\n";
        _s << "    <div class=\"btn-group\">\n";
        _s << "      <button type=\"button\" class=\"btn btn-sm btn-primary dropdown-toggle\" data-toggle-dd>Action</button>\n";
        _s << "      <div class=\"dropdown-menu dropdown-menu-end\">\n";
        _s << "        <a href=\"/admin/v1/access/users/" << h(uid) << "/edit\" class=\"dropdown-item\"><i class=\"fas fa-pen fa-fw\"></i> Edit</a>\n";
        _s << "        <div class=\"dropdown-divider\"></div>\n";
        _s << "        <form method=\"post\" action=\"/admin/v1/access/users/" << h(uid) << "?_method=DELETE\" class=\"m-0\">\n";
        _s << "          <button type=\"submit\" data-confirm=\"Confirm Delete\" class=\"dropdown-item danger\"><i class=\"fas fa-trash fa-fw\"></i> Delete</button>\n";
        _s << "        </form>\n";
        _s << "      </div>\n";
        _s << "    </div>\n";
        _s << "  </td>\n";
        _s << "</tr>\n";
    }
}
%>
        </form>
      </tbody>
    </table>

    <div class="d-flex justify-content-end mt-4">
      <nav>
        <ul class="pagination">
<%c++
auto pgLink = [&](int p) {
    return "/admin/v1/access/users?q_page=" + std::to_string(p)
        + "&q_code="   + h(qCode)
        + "&q_name="   + h(qName)
        + "&q_phone="  + h(qPhone)
        + "&q_email="  + h(qEmail)
        + "&q_status=" + h(qStatus)
        + "&q_role="   + h(qRole);
};
if(curPage > 1)
    _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"" << pgLink(curPage-1) << "\">Previous</a></li>\n";
for(int i=1; i<=totalPage; i++) {
    _s << "<li class=\"page-item" << (i==curPage?" active":"") << "\">";
    _s << "<a class=\"page-link\" href=\"" << pgLink(i) << "\">" << i << "</a></li>\n";
}
if(curPage < totalPage && totalPage > 0)
    _s << "<li class=\"page-item\"><a class=\"page-link\" href=\"" << pgLink(curPage+1) << "\">Next</a></li>\n";
%>
        </ul>
      </nav>
    </div>
  </div>
</div>

<script>
  $("#checkall").click(function(){ $('input:checkbox').not(this).prop('checked', this.checked); });
</script>
