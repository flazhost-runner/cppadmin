{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 8010,
            "https": false
        }
    ],
    "db_clients": [
        {
            "name": "default",
            "rdbms": "sqlite3",
            "filename": "./dev.db",
            "number_of_connections": 1,
            "timeout": 10.0
        }
    ],
    "redis_clients": [
        {
            "name": "default",
            "host": "127.0.0.1",
            "port": 6379,
            "username": "",
            "passwd": "",
            "db": 0,
            "is_fast": false,
            "number_of_connections": 2,
            "timeout": 5.0
        }
    ],
    "app": {
        "number_of_threads": 0,
        "enable_session": true,
        "session_timeout": 3600,
        "session_same_site": "Lax",
        "document_root": "./public",
        "home_page": "index.html",
        "upload_path": "./storage/uploads",
        "file_types": ["gif","png","jpg","jpeg","webp","svg","js","css","html","ico","woff","woff2","ttf","otf","eot"],
        "max_connections": 100000,
        "use_gzip": true,
        "static_files_cache_time": 5,
        "idle_connection_timeout": 60,
        "client_max_body_size": "10M",
        "client_max_memory_body_size": "1M",
        "log": {
            "log_level": "INFO",
            "display_local_time": true
        },
        "run_as_daemon": false,
        "handle_sig_term": true,
        "relaunch_on_error": false,
        "use_sendfile": true
    },
    "plugins": [],
    "custom_config": {
        "app_mode": "full"
    }
